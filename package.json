{
  "name": "@pushplatform/react-native",
  "version": "1.0.0",
  "description": "Push Platform React Native SDK - TypeScript bridge for iOS and Android native SDKs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "push-notifications",
    "apns",
    "fcm",
    "voip",
    "callkit",
    "ios",
    "android"
  ],
  "author": "Push Platform Team",
  "license": "MIT",
  "homepage": "https://github.com/yourorg/push-platform#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.73.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^30.5.1",
    "prettier": "^3.9.7",
    "react-native": "^0.71.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "!lib/**/*.test.*",
    "!lib/__tests__",
    "ios/PushPlatformBridge.h",
    "ios/PushPlatformBridge.m",
    "ios/PushPlatformBridge.swift",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/com/pushplatform/reactnative/",
    "android/src/main/java/com/pushplatform/sdk/core/",
    "android/src/main/java/com/pushplatform/sdk/models/",
    "android/src/main/java/com/pushplatform/sdk/notifications/",
    "!android/src/main/java/com/pushplatform/sdk/*Mock*",
    "android/build.gradle",
    "android/gradle/",
    "android/gradlew",
    "android/gradlew.bat",
    "android/settings.gradle",
    "PushPlatform.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourorg/push-platform.git",
    "directory": "sdk-react-native"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
