{
  "name": "@pushplatform/react-native",
  "version": "1.0.0",
  "description": "Push Platform React Native SDK - TypeScript bridge for iOS and Android native SDKs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "push-notifications",
    "apns",
    "fcm",
    "voip",
    "callkit",
    "ios",
    "android"
  ],
  "author": "Push Platform Team",
  "license": "MIT",
  "homepage": "https://github.com/pushplatform/pushpilot-sdk-react-native#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.77.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "!lib/**/*.test.*",
    "!lib/__tests__",
    "ios/PushPlatformBridge.m",
    "ios/PushPlatformBridge.swift",
    "android/src/main/**",
    "android/build.gradle",
    "PushPlatform.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pushplatform/pushpilot-sdk-react-native.git",
    "directory": "."
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
