{
  "name": "@pushplatform/react-native",
  "version": "1.0.2",
  "description": "PushPilot \u0434\u043b\u044f React Native \u0438 Expo: push-\u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043d\u0430 iOS \u0438 Android, \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432 \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u0439",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "lib/index.js",
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:plugin": "node --test plugin/*.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release:stage": "node scripts/stage-native.mjs",
    "release:check": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run release:check",
    "prepublishOnly": "npm run release:check"
  },
  "keywords": [
    "react-native",
    "push-notifications",
    "apns",
    "fcm",
    "voip",
    "callkit",
    "ios",
    "android"
  ],
  "author": "Push Platform Team",
  "license": "MIT",
  "homepage": "https://github.com/pushplatform/pushpilot-sdk-react-native#readme",
  "peerDependencies": {
    "@expo/config-plugins": ">=8.0.0",
    "expo": "~54.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.77.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "!lib/**/*.test.*",
    "!lib/__tests__",
    "app.plugin.js",
    "plugin/helpers.js",
    "plugin/withPushPlatform.js",
    "ios/PushPlatformBridge.m",
    "ios/PushPlatformBridge.swift",
    "android/src/main/**",
    "android/build.gradle",
    "PushPlatform.podspec",
    "react-native.config.js",
    "native/**",
    "docs/INSTALLATION.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pushplatform/pushpilot-sdk-react-native.git",
    "directory": "."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
